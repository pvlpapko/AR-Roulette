<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/ar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.pavelpapko.arroulette.MeasurementOverlayView
        android:id="@+id/measurement_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="104dp">

        <Button
            android:id="@+id/menu_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/ui_circle"
            android:contentDescription="@string/menu"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="☰"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21sp" />

        <Button
            android:id="@+id/undo_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ui_circle"
            android:contentDescription="@string/undo"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="↶"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <Button
            android:id="@+id/history_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ui_circle"
            android:contentDescription="@string/history"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="◷"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/ui_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/quality_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/ui_quality_dot"
                android:contentDescription="@string/quality" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxWidth="190dp"
                android:singleLine="true"
                android:text="@string/searching_surface"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/result_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="64dp"
        android:background="@drawable/ui_panel_strong"
        android:gravity="center"
        android:minWidth="74dp"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="—"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/mode_rail"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mode_point"
            style="@style/ModeButton"
            android:text="⌖&#10;Точка" />

        <TextView
            android:id="@+id/mode_ruler"
            style="@style/ModeButton"
            android:layout_marginTop="5dp"
            android:text="↗&#10;Рулетка" />

        <TextView
            android:id="@+id/mode_area"
            style="@style/ModeButton"
            android:layout_marginTop="5dp"
            android:text="□&#10;Площадь" />

        <TextView
            android:id="@+id/mode_height"
            style="@style/ModeButton"
            android:layout_marginTop="5dp"
            android:text="↕&#10;Высота" />

        <TextView
            android:id="@+id/mode_distance"
            style="@style/ModeButton"
            android:layout_marginTop="5dp"
            android:text="◇&#10;До объекта" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="104dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/unit_button"
            android:layout_width="58dp"
            android:layout_height="52dp"
            android:background="@drawable/ui_secondary"
            android:contentDescription="@string/unit"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="см⌄"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/grid_button"
            android:layout_width="64dp"
            android:layout_height="52dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/ui_toggle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/grid_off"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:background="@drawable/ui_panel_strong"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/hint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hint_ruler_first"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/live_distance_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aim_at_surface"
                    android:textColor="@color/muted_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/set_point_button"
                android:layout_width="116dp"
                android:layout_height="52dp"
                android:background="@drawable/ui_primary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/point_one"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/clear_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ui_circle"
            android:contentDescription="@string/clear"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⌫"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="22sp" />

        <Button
            android:id="@+id/photo_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/ui_circle"
            android:contentDescription="@string/take_photo"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="◉"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="23sp" />
    </LinearLayout>

</FrameLayout>
