<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#6623262B"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#EE34383F"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/panel_strong"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="#22FFFFFF"/></shape>
    </item>
</selector>
